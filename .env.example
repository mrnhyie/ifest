# Copy to .env.local for `vercel dev` / `vercel env add` for production.
# Neon connection string — use the POOLED endpoint (-pooler host) for serverless.
DATABASE_URL=postgresql://ROLE:PASSWORD@ep-XXX-pooler.us-east-2.aws.neon.tech/ifest?sslmode=require

# Admin token for /admin (X-Admin-Token). Generate: openssl rand -hex 24
ADMIN_TOKEN=
